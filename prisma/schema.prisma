// Story E0-04: Organization, User, Plan, Subscription (docs/03_Data_Model.md: E01, E02, E12, E13).
// Story E0-05: Warehouse, UserWarehouse, Product, StockLevel, StockTransfer, StockMovement,
// IdempotencyKey (E04 to E10).
// Story E0-06: Invitation, ImportJob, Invoice, WebhookEvent, AuditLog, Notification (E03, E11,
// E14 to E17). All 17 entities now exist.
// Rules Prisma cannot express (one Owner per organization, lowercase email, CHECK constraints,
// the immutability triggers on stock_movements and audit_logs) live in the custom SQL at the end
// of the migrations. See prisma/migrations/*_init, *_stock_schema and *_billing_schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED

  @@map("organization_status")
}

enum UserRole {
  PLATFORM_ADMIN
  OWNER
  WAREHOUSE_ADMIN
  VIEWER

  @@map("user_role")
}

// E01: one row per customer company.
model Organization {
  id        String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  slug      String             @unique
  address   String?
  status    OrganizationStatus @default(TRIAL)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  users           User[]
  subscription    Subscription?
  warehouses      Warehouse[]
  userWarehouses  UserWarehouse[]
  products        Product[]
  stockLevels     StockLevel[]
  stockTransfers  StockTransfer[]
  stockMovements  StockMovement[]
  idempotencyKeys IdempotencyKey[]
  invitations     Invitation[]
  importJobs      ImportJob[]
  invoices        Invoice[]
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@map("organizations")
}

// E02: organizationId is empty only for a PLATFORM_ADMIN.
model User {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId    String?   @map("organization_id") @db.Uuid
  email             String    @unique
  name              String
  passwordHash      String    @map("password_hash")
  role              UserRole
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  resetTokenHash    String?   @map("reset_token_hash")
  resetExpiresAt    DateTime? @map("reset_expires_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Restrict is explicit: the default for an optional relation is SetNull, which would turn a
  // tenant user into a platform admin. Business data is archived, never deleted.
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  userWarehouses UserWarehouse[]
  stockTransfers StockTransfer[]
  stockMovements StockMovement[]
  invitations    Invitation[]
  importJobs     ImportJob[]
  auditLogs      AuditLog[]
  notifications  Notification[]

  @@index([organizationId])
  @@map("users")
}

// E12: global (no organizationId), filled by the seed.
model Plan {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String   @unique
  priceIdr      Int      @map("price_idr")
  maxWarehouses Int      @map("max_warehouses")
  maxProducts   Int      @map("max_products")
  maxMembers    Int      @map("max_members")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("plans")
}

// E13: one per organization. The status lives in Organization.status, not here.
model Subscription {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId     String   @unique @map("organization_id") @db.Uuid
  planId             String   @map("plan_id") @db.Uuid
  billingDay         Int?     @map("billing_day")
  currentPeriodStart DateTime @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime @map("current_period_end") @db.Timestamptz(3)
  graceUntil         DateTime @map("grace_until") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices     Invoice[]

  @@index([planId])
  @@map("subscriptions")
}

enum ProductUnit {
  bks
  ktk
  pcs
  btl
  jrg
  pak

  @@map("product_unit")
}

enum StockMovementType {
  RECEIVE
  ADJUST
  TRANSFER_OUT
  TRANSFER_IN
  IMPORT

  @@map("stock_movement_type")
}

enum StockMovementReason {
  STOCK_OPNAME
  DAMAGED
  LOST
  CORRECTION

  @@map("stock_movement_reason")
}

// E04: archived, never deleted (rule 8). The code format is a CHECK in the migration (BL08).
model Warehouse {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  address        String?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userWarehouses UserWarehouse[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")

  @@unique([organizationId, code])
  @@map("warehouses")
}

// E05: only Warehouse Admins and Viewers have rows. The primary key is the unique (userId, warehouseId).
model UserWarehouse {
  userId         String   @map("user_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([userId, warehouseId])
  @@index([organizationId])
  @@index([warehouseId])
  @@map("user_warehouses")
}

// E06: the SKU format is a CHECK in the migration (BL09).
model Product {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  sku            String
  name           String
  unit           ProductUnit
  minStock       Int         @default(0) @map("min_stock")
  archivedAt     DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  @@unique([organizationId, sku])
  @@map("products")
}

// E07: the current balance. CHECK (quantity >= 0) is in the migration, the last safety net for BL13.
model StockLevel {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  quantity       Int
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, productId])
  @@index([organizationId, productId])
  @@index([organizationId, warehouseId])
  @@map("stock_levels")
}

// E08: transfer header, always completed (no status, no updatedAt). from <> to is a CHECK in the migration.
model StockTransfer {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  code            String
  fromWarehouseId String   @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String   @map("to_warehouse_id") @db.Uuid
  note            String?
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fromWarehouse Warehouse       @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse       @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  createdBy     User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  movements     StockMovement[]

  @@unique([organizationId, code])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([createdById])
  @@map("stock_transfers")
}

// E09: append-only. A trigger in the migration rejects UPDATE and DELETE (ADR 0005).
// importJobId may be filled only for type IMPORT (CHECK in the E0-05 migration).
model StockMovement {
  id             String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  warehouseId    String               @map("warehouse_id") @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  quantityDelta  Int                  @map("quantity_delta")
  type           StockMovementType
  transferId     String?              @map("transfer_id") @db.Uuid
  importJobId    String?              @map("import_job_id") @db.Uuid
  reason         StockMovementReason?
  note           String?
  createdById    String               @map("created_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  transfer     StockTransfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)
  importJob    ImportJob?     @relation(fields: [importJobId], references: [id], onDelete: Restrict)
  createdBy    User           @relation(fields: [createdById], references: [id], onDelete: Restrict)

  // Every composite index starts with organizationId (BL16). The first one serves the history
  // list with cursor pagination (newest first, id as tie-breaker).
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, productId, createdAt(sort: Desc)])
  @@index([organizationId, warehouseId, createdAt(sort: Desc)])
  @@index([transferId])
  @@index([importJobId])
  @@index([createdById])
  @@map("stock_movements")
}

// E10: the unique key is the only source of truth for idempotency (BL14). resourceId points to a
// StockTransfer, StockMovement or ImportJob depending on endpoint, so it has no foreign key.
model IdempotencyKey {
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  endpoint       String
  resourceId     String   @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, key, endpoint])
  @@index([createdAt])
  @@map("idempotency_keys")
}

enum ImportJobStatus {
  PREVIEW
  COMMITTED
  FAILED

  @@map("import_job_status")
}

enum InvoiceKind {
  INITIAL
  PLAN_CHANGE
  RENEWAL

  @@map("invoice_kind")
}

enum InvoiceStatus {
  PENDING
  PAID
  EXPIRED
  FAILED

  @@map("invoice_status")
}

enum NotificationType {
  LOW_STOCK
  INVOICE_DUE
  TRIAL_ENDING
  SUSPENDED

  @@map("notification_type")
}

// E03: the token is stored only as a hash. Pending, Expired and Accepted are derived from
// expiresAt and acceptedAt; a cancelled invitation is deleted (the only deletable table here, by
// design in the data model). warehouseIds is a list of IDs, not a foreign key (ERD_Relations.md).
// The role (WAREHOUSE_ADMIN or VIEWER) and lowercase email are CHECKs in the migration.
model Invitation {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  role           UserRole
  warehouseIds   String[]  @map("warehouse_ids") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  // "One pending invitation per email" is an application rule (BL05), so this index is only for lookups.
  @@index([organizationId, email])
  @@index([createdById])
  @@map("invitations")
}

// E11: the validation result of an import. rows holds the valid rows for the commit (BL18).
model ImportJob {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  fileName       String          @map("file_name")
  status         ImportJobStatus @default(PREVIEW)
  totalRows      Int             @map("total_rows")
  errorRows      Int             @map("error_rows")
  errorReport    Json            @default("[]") @map("error_report")
  rows           Json
  createdById    String          @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([createdById])
  @@map("import_jobs")
}

// E14: the Xendit invoice. externalId is the join to webhook events (no foreign key, WebhookEvent
// is global). planId is the plan that takes effect once paid.
model Invoice {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  planId         String        @map("plan_id") @db.Uuid
  number         String
  amountIdr      Int           @map("amount_idr")
  kind           InvoiceKind
  periodStart    DateTime      @map("period_start") @db.Timestamptz(3)
  periodEnd      DateTime      @map("period_end") @db.Timestamptz(3)
  status         InvoiceStatus @default(PENDING)
  externalId     String        @unique @map("external_id")
  paymentUrl     String?       @map("payment_url")
  dueAt          DateTime      @map("due_at") @db.Timestamptz(3)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(3)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([subscriptionId])
  @@index([planId])
  @@map("invoices")
}

// E15: global, no organizationId (docs/03_Data_Model.md). The unique (provider, eventId) is what
// makes a duplicate webhook harmless (BL22). receivedAt is its created time, so there is no createdAt.
model WebhookEvent {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// E16: append-only. A trigger in the migration rejects UPDATE and DELETE (same idea as ADR 0005).
// entityType and entityId are a loose reference, not a foreign key (ERD_Relations.md).
model AuditLog {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

// E17: in-app notifications, readable only by the target user (BL30).
model Notification {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  message        String
  readAt         DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Serves the bell dropdown: the newest 20 of one user (S-notification panel).
  @@index([organizationId, userId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("notifications")
}
