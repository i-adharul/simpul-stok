# Copy this file to .env and adjust. Never commit .env.
# NODE_ENV is set by Next.js itself; do not define it here.

# Local development database (see docker-compose.yml)
DATABASE_URL=postgresql://simpul:simpul@localhost:5433/simpul_dev

# Signs the session cookie. At least 32 characters; the placeholder below is rejected on purpose.
# Generate one: openssl rand -base64 48   (use a different value per environment)
SESSION_SECRET=CHANGE-ME-example-value-not-a-real-secret

# Database used by automated tests
TEST_DATABASE_URL=postgresql://simpul:simpul@localhost:5433/simpul_test

# Seed safety: `pnpm prisma db seed` only accepts a local database. Leave this empty. Setting it to the
# exact text in src/modules/platform/seed.ts lets the seed write public demo accounts to a remote database.
SEED_ALLOW_REMOTE=

# Demo seed (`pnpm seed:demo`) on a remote database only: the password for the demo accounts, which the
# seed then uses instead of the committed local passwords. Leave empty locally. Never commit a real value.
DEMO_PASSWORD=

# Set by Vercel itself (needs "Automatically expose System Environment Variables" in the project
# settings). Leave empty locally; GET /api/health then reports commit: null.
VERCEL_GIT_COMMIT_SHA=
