# Log in first with http/auth.http (Owner or Warehouse Admin), then run these in the same VS Code session.
# Replace the ids with real ones from GET /api/warehouses, GET /api/stock/transfers/destinations and GET /api/products.
# Every write needs an Origin header equal to the server's own scheme and host, and an Idempotency-Key
# (a UUID; the client makes a new one each time a form is opened).

@warehouseId = 00000000-0000-7000-8000-000000000001
@productId = 00000000-0000-7000-8000-000000000002
@toWarehouseId = 00000000-0000-7000-8000-000000000003

### Receive stock
# Expect 201 { id, warehouseId, productId, quantity: 24, createdAt } (never the current stock)
POST http://localhost:3000/api/stock/receive
Origin: http://localhost:3000
Content-Type: application/json
Idempotency-Key: 6f1d2c1e-3b0a-4c55-9c1a-0f7d3b9a1e01

{ "warehouseId": "{{warehouseId}}", "productId": "{{productId}}", "quantity": 24, "note": "PO-123" }

### Same key again (a retry)
# Expect 201 with the identical body and the response header Idempotency-Replayed: true; stock grows once
POST http://localhost:3000/api/stock/receive
Origin: http://localhost:3000
Content-Type: application/json
Idempotency-Key: 6f1d2c1e-3b0a-4c55-9c1a-0f7d3b9a1e01

{ "warehouseId": "{{warehouseId}}", "productId": "{{productId}}", "quantity": 24, "note": "PO-123" }

### Missing Idempotency-Key
# Expect 400 VALIDATION_ERROR with details [{ source: "header", path: "Idempotency-Key" }]
POST http://localhost:3000/api/stock/receive
Origin: http://localhost:3000
Content-Type: application/json

{ "warehouseId": "{{warehouseId}}", "productId": "{{productId}}", "quantity": 24 }

### Quantity out of range
# Expect 400 VALIDATION_ERROR (quantity is a whole number from 1 to 1,000,000)
POST http://localhost:3000/api/stock/receive
Origin: http://localhost:3000
Content-Type: application/json
Idempotency-Key: 6f1d2c1e-3b0a-4c55-9c1a-0f7d3b9a1e02

{ "warehouseId": "{{warehouseId}}", "productId": "{{productId}}", "quantity": 1000001 }

### Unknown or foreign warehouse
# Expect 403 FORBIDDEN (the same for another organization's warehouse and one that does not exist)
POST http://localhost:3000/api/stock/receive
Origin: http://localhost:3000
Content-Type: application/json
Idempotency-Key: 6f1d2c1e-3b0a-4c55-9c1a-0f7d3b9a1e03

{ "warehouseId": "00000000-0000-7000-8000-00000000ffff", "productId": "{{productId}}", "quantity": 1 }

### Unknown or foreign product
# Expect 404 NOT_FOUND
POST http://localhost:3000/api/stock/receive
Origin: http://localhost:3000
Content-Type: application/json
Idempotency-Key: 6f1d2c1e-3b0a-4c55-9c1a-0f7d3b9a1e04

{ "warehouseId": "{{warehouseId}}", "productId": "00000000-0000-7000-8000-00000000ffff", "quantity": 1 }

### Adjust stock (SET: the value is the new quantity)
# Owner or Warehouse Admin of the warehouse. Expect 201 { id, warehouseId, productId, quantity: <difference>, createdAt, reason }
POST http://localhost:3000/api/stock/adjust
Origin: http://localhost:3000
Content-Type: application/json
Idempotency-Key: 6f1d2c1e-3b0a-4c55-9c1a-0f7d3b9a1e11

{ "warehouseId": "{{warehouseId}}", "productId": "{{productId}}", "mode": "SET", "value": 10, "reason": "STOCK_OPNAME", "note": "Hitung ulang" }

### Adjust stock (DELTA: the value is the difference)
# Expect 201; 409 if the result would be below 0; 400 if the difference is 0 or a limit of 1,000,000 is passed
POST http://localhost:3000/api/stock/adjust
Origin: http://localhost:3000
Content-Type: application/json
Idempotency-Key: 6f1d2c1e-3b0a-4c55-9c1a-0f7d3b9a1e12

{ "warehouseId": "{{warehouseId}}", "productId": "{{productId}}", "mode": "DELTA", "value": -2, "reason": "DAMAGED" }

### Adjust below zero
# Expect 409 CONFLICT "Stok tidak boleh menjadi kurang dari 0."
POST http://localhost:3000/api/stock/adjust
Origin: http://localhost:3000
Content-Type: application/json
Idempotency-Key: 6f1d2c1e-3b0a-4c55-9c1a-0f7d3b9a1e13

{ "warehouseId": "{{warehouseId}}", "productId": "{{productId}}", "mode": "DELTA", "value": -999999, "reason": "LOST" }

### Movement history, first page (50 rows, newest first)
# Expect 200 { items: [...], nextCursor: "..." | null }. Filters: productId, warehouseId, type, createdById, from, to.
GET http://localhost:3000/api/stock/movements?type=RECEIVE&productId={{productId}}

### Movement history, next page
# Paste the nextCursor of the previous answer. A malformed cursor gives 400 VALIDATION_ERROR.
GET http://localhost:3000/api/stock/movements?cursor=PASTE_NEXT_CURSOR

### Movement detail (P13)
# Expect 200 with warehouse, product, createdBy (id, name, role), transfer (or null). 404 for an unknown
# id, another organization's id, or a warehouse the user is not assigned to.
GET http://localhost:3000/api/stock/movements/{{movementId}}

### Stock summary (all accessible warehouses)
# Expect 200 { items: [{ warehouse, product, quantity, status, updatedAt }], total, page, pageSize, summary: { out, low, ok } }
GET http://localhost:3000/api/stock?page=1&pageSize=20

### Stock summary, low stock of one warehouse, searched
# Expect 200 with only status LOW rows; summary still counts all three statuses. 403 if the warehouse is not yours.
GET http://localhost:3000/api/stock?warehouseId={{warehouseId}}&status=LOW&q=kopi

### Stock summary with a bad status
# Expect 400 VALIDATION_ERROR
GET http://localhost:3000/api/stock?status=EMPTY

### Transfer stock between warehouses (BL13)
# Expect 201 { id, code: "MT-0001", fromWarehouseId, toWarehouseId, items: [{ productId, quantity }], note, createdAt }
# (never the current stock). The destination may be any active warehouse; the source must be yours.
POST http://localhost:3000/api/stock/transfers
Origin: http://localhost:3000
Content-Type: application/json
Idempotency-Key: 7a2e3d2f-4c1b-4d66-8d2b-1a8e4c0b2f01

{
  "fromWarehouseId": "{{warehouseId}}",
  "toWarehouseId": "{{toWarehouseId}}",
  "items": [{ "productId": "{{productId}}", "quantity": 5 }],
  "note": "Isi ulang gudang cabang"
}

### Same key again (a retry)
# Expect 201 with the identical body and Idempotency-Replayed: true; stock moves once
POST http://localhost:3000/api/stock/transfers
Origin: http://localhost:3000
Content-Type: application/json
Idempotency-Key: 7a2e3d2f-4c1b-4d66-8d2b-1a8e4c0b2f01

{
  "fromWarehouseId": "{{warehouseId}}",
  "toWarehouseId": "{{toWarehouseId}}",
  "items": [{ "productId": "{{productId}}", "quantity": 5 }],
  "note": "Isi ulang gudang cabang"
}

### Same source and destination
# Expect 400 VALIDATION_ERROR (toWarehouseId must differ from fromWarehouseId)
POST http://localhost:3000/api/stock/transfers
Origin: http://localhost:3000
Content-Type: application/json
Idempotency-Key: 7a2e3d2f-4c1b-4d66-8d2b-1a8e4c0b2f02

{ "fromWarehouseId": "{{warehouseId}}", "toWarehouseId": "{{warehouseId}}", "items": [{ "productId": "{{productId}}", "quantity": 1 }] }

### More than the source holds
# Expect 409 INSUFFICIENT_STOCK with details { productId }
POST http://localhost:3000/api/stock/transfers
Origin: http://localhost:3000
Content-Type: application/json
Idempotency-Key: 7a2e3d2f-4c1b-4d66-8d2b-1a8e4c0b2f03

{ "fromWarehouseId": "{{warehouseId}}", "toWarehouseId": "{{toWarehouseId}}", "items": [{ "productId": "{{productId}}", "quantity": 1000000 }] }

### Destinations for the transfer form
# Expect 200 { items: [{ id, code, name }] } with every active warehouse (Owner and Warehouse Admin; a Viewer gets 403)
GET http://localhost:3000/api/stock/transfers/destinations
