# Log in first with http/auth.http (Owner), then run these in the same VS Code session.
# Every write needs an Origin header equal to the server's own scheme and host.

### List warehouses (page, pageSize, includeArchived for the Owner)
# Expect 200 { items, total, page, pageSize }
GET http://localhost:3000/api/warehouses?page=1&pageSize=20

### Create a warehouse (Owner only)
# Expect 201 with code "GD-99" (stored uppercase)
POST http://localhost:3000/api/warehouses
Origin: http://localhost:3000
Content-Type: application/json

{ "code": "gd-99", "name": "Gudang Sembilan", "address": "Jl. Mawar 9" }

### Duplicate code
# Expect 409 { "code": "CONFLICT", "message": "Kode gudang sudah dipakai." }
POST http://localhost:3000/api/warehouses
Origin: http://localhost:3000
Content-Type: application/json

{ "code": "GD-99", "name": "Duplikat" }

### Invalid body
# Expect 400 VALIDATION_ERROR
POST http://localhost:3000/api/warehouses
Origin: http://localhost:3000
Content-Type: application/json

{ "code": "", "name": "" }

### Get one warehouse (replace the id)
# Expect 200; 403 if a Viewer is not assigned to it; 404 for another organization's id
GET http://localhost:3000/api/warehouses/00000000-0000-0000-0000-000000000000

### Edit a warehouse (Owner only; replace the id)
# Expect 200; 409 if the code is taken by another warehouse
PATCH http://localhost:3000/api/warehouses/00000000-0000-0000-0000-000000000000
Origin: http://localhost:3000
Content-Type: application/json

{ "name": "Nama baru", "address": null }

### Archive a warehouse (Owner only; replace the id)
# Expect 200 with archivedAt set; 409 CONFLICT while any stock is above 0
PATCH http://localhost:3000/api/warehouses/00000000-0000-0000-0000-000000000000
Origin: http://localhost:3000
Content-Type: application/json

{ "archived": true }

### Restore a warehouse (Owner only; replace the id)
# Expect 200 with archivedAt null; the Owner can GET an archived warehouse, other roles get 404
PATCH http://localhost:3000/api/warehouses/00000000-0000-0000-0000-000000000000
Origin: http://localhost:3000
Content-Type: application/json

{ "archived": false }
