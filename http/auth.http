# Every write request (POST, PATCH, PUT, DELETE) from a non-browser client must send an Origin header equal to
# the server's own scheme and host, e.g. "Origin: http://localhost:3000" locally. Without it the CSRF check
# answers 403. curl: curl -X POST http://localhost:3000/api/auth/logout -H "Origin: http://localhost:3000"

### Login as the demo Owner (seed account). Local server: pnpm dev
# Expect 200 {"user":{...,"role":"OWNER"},"redirectTo":"/dashboard"}
# Response header: Set-Cookie: __Host-simpul_session=<token>; Max-Age=28800; Path=/; HttpOnly; Secure; SameSite=lax
# The cookie is Secure: Chrome and Firefox accept it on http://localhost, curl and Safari may not store it.
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{ "email": "owner@demotoko.test", "password": "owner-demo-2026" }

### Login as the platform admin
# Expect 200 with "redirectTo":"/platform"
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{ "email": "admin@simpul.test", "password": "platform-demo-2026" }

### Email is compared in lowercase (spaces around it are ignored)
# Expect 200
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{ "email": " OWNER@DemoToko.test ", "password": "owner-demo-2026" }

### Wrong password
# Expect 401 {"code":"INVALID_CREDENTIALS","message":"Email atau password salah.","details":null}
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{ "email": "owner@demotoko.test", "password": "not-the-password-1" }

### Unknown email
# Expect the SAME 401 body as above (no account enumeration)
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{ "email": "nobody@demotoko.test", "password": "owner-demo-2026" }

### Inactive user
# First: UPDATE users SET is_active = false WHERE email = 'viewer@demotoko.test';
# Expect the SAME 401 body as above. Restore with is_active = true afterwards.
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{ "email": "viewer@demotoko.test", "password": "viewer-demo-2026" }

### Password over 72 bytes
# Expect the SAME 401 body (never truncated, never explained)
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{ "email": "owner@demotoko.test", "password": "owner-demo-2026xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }

### Missing password
# Expect 400 {"code":"VALIDATION_ERROR","message":"Email dan password wajib diisi.","details":null}
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{ "email": "owner@demotoko.test" }

### Body that is not JSON
# Expect 400 VALIDATION_ERROR
POST http://localhost:3000/api/auth/login
Content-Type: application/json

not json

### Current user (send the cookie from login; in VS Code REST Client use a named request or paste it)
# Expect 200 {"user":{...},"organization":{...}}; without a valid session 401 {"code":"UNAUTHENTICATED",...}
GET http://localhost:3000/api/me
Cookie: __Host-simpul_session=<token from login>

### Logout
# Expect 204 and Set-Cookie: __Host-simpul_session=; Max-Age=0
POST http://localhost:3000/api/auth/logout

### Change own password (S17/P17). Needs the session cookie; any role, any subscription state (BL23)
# Expect 204 and a new Set-Cookie. Sessions created before this call (other devices) get 401 afterwards.
# Restore the seed password afterwards (re-run the seed) or the other requests in this file will fail.
PATCH http://localhost:3000/api/me/password
Content-Type: application/json
Cookie: __Host-simpul_session=<token from login>

{ "currentPassword": "owner-demo-2026", "newPassword": "kopi-senja-baru-77" }

### Change password: wrong current password
# Expect 400 {"code":"INVALID_CURRENT_PASSWORD","message":"Password saat ini salah.","details":null}
PATCH http://localhost:3000/api/me/password
Content-Type: application/json
Cookie: __Host-simpul_session=<token from login>

{ "currentPassword": "salah-banget-1", "newPassword": "kopi-senja-baru-77" }

### Change password: new password breaks the rules
# Expect 400 {"code":"VALIDATION_ERROR","message":"Password terlalu umum.","details":{"field":"newPassword"}}
PATCH http://localhost:3000/api/me/password
Content-Type: application/json
Cookie: __Host-simpul_session=<token from login>

{ "currentPassword": "owner-demo-2026", "newPassword": "password123" }

### Change password without a session
# Expect 401 UNAUTHENTICATED
PATCH http://localhost:3000/api/me/password
Content-Type: application/json

{ "currentPassword": "owner-demo-2026", "newPassword": "kopi-senja-baru-77" }

### CSRF: a write with a foreign Origin is rejected (E1-06)
# Expect 403 {"code":"CSRF_REJECTED",...}. A write with no Origin header is also 403; an http Origin against an https host is rejected too.
POST http://localhost:3000/api/auth/login
Origin: https://evil.example
Content-Type: application/json

{"email":"owner@example.com","password":"whatever-password"}
